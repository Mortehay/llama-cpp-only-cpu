# syntax=docker/dockerfile:1
# GPU variant of compose/develop/sprite_generator/Dockerfile.
#
# Deliberately NOT based on an nvidia/cuda image: the PyTorch CUDA wheels vendor
# their own CUDA runtime libraries, so the container only needs the host driver
# exposed by nvidia-container-toolkit. That keeps this image close to the CPU one
# and avoids a ~3GB CUDA base layer.
# 3.11, not 3.10, since 2026-09-12: ACE-Step 1.5 (the audio model, decisions/0010)
# requires Python 3.11-3.12. The bump alone changed nothing in the image except
# the re-resolved wheels (torch 2.13->2.14, numpy 2.2->2.4); gpu-health, the
# world-gen smoke and an SDXL+LoRA txt2img all passed on it.

# The brain's llama-server (decisions/0013) - copied from, never run as, this
# stage. Pinned by digest: the build measured on this host on 2026-10-01.
FROM ghcr.io/ggml-org/llama.cpp@sha256:85e30d01b550277f25ccb62a4acab4626d5738974c137ee257b21a90dce94c14 AS llama

FROM python:3.11-slim

WORKDIR /app

# libgl1/libglib2.0-0 are required by rembg's OpenCV dependency.
#
# build-essential is NOT optional on this image, and the reason is not obvious:
# torch dispatches some ops (bmm_outer_product among them) to Triton, and Triton
# JIT-COMPILES its CUDA driver shim at first use with the system C compiler.
# python:3.11-slim has none, so the failure lands at inference time rather than
# build time, deep in a stack of torch -> triton -> driver frames:
#
#   RuntimeError: Failed to find C compiler. Please specify via CC environment
#   variable or set triton.knobs.build.impl
#
# Nothing about that message suggests a missing apt package, and it does not
# appear until a model actually runs - measured 2026-08-23, on the first
# Qwen-Image-Edit turnaround, after a 16GB download.
#
# libsndfile1 backs `soundfile`, which is how audio_master writes the OGG
# Vorbis loop. Without it the import succeeds and the write fails.
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# torch in its own layer: it is large and changes rarely, unlike the app deps
# below. The pip cache mount means a rebuild never re-downloads it.
#
# No index gymnastics. PyPI's default torch is a current-CUDA build, which the
# host driver (610.88 / CUDA 13.3) runs natively.
#
# HISTORY, so nobody "fixes" this back: under the previous driver (551.86 /
# CUDA 12.4) this had to be pinned to cu124, and neither pip index flag worked
# alone -- `--extra-index-url` unpinned silently installed a too-new CUDA build
# that reported torch.cuda.is_available() == False, while exclusive
# `--index-url` broke dependency resolution (typing_extensions name mismatch ->
# sdist fallback -> missing flit_core). If the driver is ever DOWNGRADED, pin
# with `--extra-index-url <torch-index> torch==<ver>+cuXXX`; the +cuXXX local
# version tag exists only on the PyTorch index, so it forces that exact wheel
# while ordinary dependencies still resolve from PyPI.
# See .ai/decisions/0001-gpu-pivot-and-engine-choice.md
#
# torchvision is installed HERE, in the same command as torch, not in
# requirements.cuda.txt. Resolving it in a later layer lets pip pick a
# torchvision built against a different torch and quietly reinstall torch to
# match — which would undo the CUDA build this layer just established.
# Without torchvision, transformers falls back to PIL image processors
# ("CLIPImageProcessor requires torchvision"); fine for plain txt2img, but
# img2img and image-to-text models expect the real backend.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch torchvision

# ACE-Step 1.5, the music model, in an ISOLATED venv at /opt/acestep/.venv.
# It pins torch 2.10.0+cu128 and transformers <4.58; the layers above carry
# torch 2.14/cu130 and transformers 5.x for diffusers. One site-packages cannot
# hold both, so audio_engine spawns this venv's python as a subprocess after
# evicting the diffusers pipelines - still one process on the card at a time,
# because the solo worker blocks on the child (decisions/0010, D6).
#
# Placed BEFORE requirements.txt on purpose: that file changes often and this
# layer is ~14 GB of wheels, so a routine requirements edit must hit the cache
# here instead of re-downloading it. Pinned to the commit 0010 was measured on,
# not `main` - `uv sync --frozen` is only reproducible if the lockfile is.
# ffmpeg backs torchcodec in their stack, as in their own Dockerfile.
ARG ACESTEP_REF=ca1e85f
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --filter=blob:none https://github.com/ace-step/ACE-Step-1.5 /opt/acestep \
    && git -C /opt/acestep checkout ${ACESTEP_REF}
ENV UV_HTTP_TIMEOUT=900
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /opt/acestep && uv sync --frozen --no-dev --python /usr/local/bin/python3.11 \
    && /opt/acestep/.venv/bin/python -c "import torch, transformers; \
       print('acestep venv:', torch.__version__, torch.version.cuda, transformers.__version__)"
ENV ACESTEP_PROJECT_ROOT=/opt/acestep

# llama-server, the brain (decisions/0013), at /opt/llama - a child process the
# worker starts and stops through the model gateway, never a resident service.
# Copied from the official CUDA image rather than built: its Ubuntu 24.04 glibc
# (2.39) is older than this base's, so the binaries run unchanged (T0 spike,
# 2026-10-01). Its CUDA 12.8 runtime libs come along into /opt/llama/lib and
# are put on LD_LIBRARY_PATH for the CHILD only - the worker's own torch is
# cu130 and must not see them. libcuda.so.1 is injected by the NVIDIA runtime.
COPY --from=llama /app /opt/llama/app
COPY --from=llama /usr/local/cuda/lib64/libcudart.so.12.8.90 /opt/llama/lib/libcudart.so.12
COPY --from=llama /usr/local/cuda/lib64/libcublas.so.12.8.4.1 /opt/llama/lib/libcublas.so.12
COPY --from=llama /usr/local/cuda/lib64/libcublasLt.so.12.8.4.1 /opt/llama/lib/libcublasLt.so.12
COPY --from=llama /usr/lib/x86_64-linux-gnu/libnccl.so.2.25.1 /opt/llama/lib/libnccl.so.2
RUN LD_LIBRARY_PATH=/opt/llama/app:/opt/llama/lib /opt/llama/app/llama-server --version
ENV LLAMA_SERVER_BIN=/opt/llama/app/llama-server \
    LLAMA_SERVER_LIBS=/opt/llama/app:/opt/llama/lib

COPY compose/develop/sprite_generator/requirements.cuda.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Fail the BUILD rather than shipping an image that silently runs on CPU.
# torch.version.cuda is None for a CPU-only wheel. Actual device visibility
# needs --gpus at run time and is covered by `make gpu-check`.
RUN python -c "import torch, sys; \
    v = torch.version.cuda; \
    print('torch', torch.__version__, 'built for CUDA', v); \
    sys.exit(0 if v else 1)"

# And prove the two stacks still coexist after requirements.txt resolved:
# the worker's diffusers stack at its versions, the venv's at its own.
RUN python -c "import torch, diffusers, transformers; \
    print('worker :', torch.__version__, diffusers.__version__, transformers.__version__)" \
    && /opt/acestep/.venv/bin/python -c "import torch, transformers; \
    print('acestep:', torch.__version__, torch.version.cuda, transformers.__version__)"

COPY src/sprite_generator/ .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]
